# Copy to llm/model.env (gitignored) or set these as CI secrets.
# The model is SaaS and SWAPPABLE — everything talks an OpenAI-compatible API,
# so OpenAI / Claude / Mistral (or an aggregator, or a local vLLM/Ollama endpoint)
# is a string swap. We target OpenAI directly with the current flagship.

OPENAI_BASE_URL="https://api.openai.com/v1"       # OpenAI direct (OpenAI-compatible API)
OPENAI_API_KEY="sk-REDACTED"                      # CI secret; NEVER commit the real key
FIXLOOP_MODEL="gpt-5.6-sol"                        # flagship; swap freely: gpt-5.6-terra, gpt-5.3-codex, o3
FIXLOOP_MODEL_FALLBACK="gpt-5.6-terra"            # optional 2nd try on refusal/error

# Guardrails (auto/autonomy.md §4, llm-fix-loop.md)
FIXLOOP_MAX_ATTEMPTS=3                             # diminishing returns past ~3
FIXLOOP_MAX_SPEND_USD=5.00                         # per-package per-run ceiling

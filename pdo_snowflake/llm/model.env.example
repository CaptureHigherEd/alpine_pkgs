# Copy to llm/model.env (gitignored) or set these as CI secrets.
# The model is SaaS and SWAPPABLE — everything talks an OpenAI-compatible API,
# so Claude / Mistral / Z.ai (or a local vLLM/Ollama endpoint) is a string swap.
# An aggregator (OpenRouter) is recommended: one endpoint, one key, spend caps.

OPENAI_BASE_URL="https://openrouter.ai/api/v1"   # aggregator -> Claude|Mistral|Z.ai
OPENAI_API_KEY="sk-REDACTED"                      # CI secret; NEVER commit the real key
FIXLOOP_MODEL="anthropic/claude-opus-4-8"         # swap freely: mistralai/..., zhipu/...
FIXLOOP_MODEL_FALLBACK="mistralai/mistral-large"  # optional 2nd try on refusal/error

# Guardrails (auto/autonomy.md §4, llm-fix-loop.md)
FIXLOOP_MAX_ATTEMPTS=3                             # diminishing returns past ~3
FIXLOOP_MAX_SPEND_USD=2.00                         # per-package per-run ceiling

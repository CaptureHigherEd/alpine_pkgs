#!/bin/sh
# fix-loop <package> <build-log> — the LLM build-doctor (auto/llm-fix-loop.md).
#
# On a build failure, iterate up to N times: classify the error, prompt a
# swappable model for a minimal guarded musl patch, apply it to the source tree,
# re-verify the build, and either keep the patch (success) or escalate
# (needs-human). "It compiles" != "it's correct": an LLM-authored patch is a
# CANDIDATE held for human review — this script never publishes.
#
# Patch provider (FIXLOOP_PATCH_PROVIDER, default "api"), so the loop is testable
# without a live model:
#   api            OpenAI-compatible chat completion (OPENAI_BASE_URL/_API_KEY/FIXLOOP_MODEL)
#   replay:<path>  use a canned unified diff at <path> (CI-without-model / tests)
#   cmd:<path>     run <path> with the prompt on stdin; expect a diff on stdout
#
# Verify is pluggable too (defaults target this package's client build):
#   FIXLOOP_TREE          repo-relative tree the patch applies to
#   FIXLOOP_VERIFY_IMAGE  container image for the rebuild (default alpine:3.22)
#   FIXLOOP_VERIFY_SETUP  apk packages to install before verifying
#   FIXLOOP_VERIFY_CMD    command (run in FIXLOOP_TREE) that exits 0 iff fixed
#   FIXLOOP_APPLY_TO_PACKAGE=1  on success, save the patch into the package + source=
set -eu
die() { echo "fix-loop: $*" >&2; exit 2; }
command -v jq >/dev/null 2>&1 || die "need jq"
command -v docker >/dev/null 2>&1 || die "need docker"

pkg=${1:-}; log=${2:-}
[ -n "$pkg" ] && [ -n "$log" ] && [ -f "$log" ] || die "usage: fix-loop <package> <build-log>"
REPO=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); cd "$REPO"
pdir="packages/$pkg"

N=${FIXLOOP_MAX_ATTEMPTS:-3}
provider=${FIXLOOP_PATCH_PROVIDER:-api}
tree=${FIXLOOP_TREE:-$pdir/src/sfclient}
vimage=${FIXLOOP_VERIFY_IMAGE:-alpine:3.22}
vsetup=${FIXLOOP_VERIFY_SETUP:-build-base cmake make perl python3 bash git linux-headers curl coreutils}
vcmd=${FIXLOOP_VERIFY_CMD:-bash scripts/build_libsnowflakeclient.sh -t Release}
apply_pkg=${FIXLOOP_APPLY_TO_PACKAGE:-1}
work=".build/fixloop"; mkdir -p "$work"

# --- provider: prompt (stdin) -> unified diff (stdout) -----------------------
gen_patch() {
	case "$provider" in
	replay:*) cat "${provider#replay:}" ;;
	cmd:*)    "${provider#cmd:}" ;;
	api)
		[ -n "${OPENAI_BASE_URL:-}" ] && [ -n "${OPENAI_API_KEY:-}" ] \
			&& [ -n "${FIXLOOP_MODEL:-}" ] || die "api provider needs OPENAI_BASE_URL/_API_KEY/FIXLOOP_MODEL"
		sys=$(cat "$REPO/llm/prompts/musl-fix.md")
		usr=$(cat)
		jq -n --arg m "$FIXLOOP_MODEL" --arg s "$sys" --arg u "$usr" \
			'{model:$m, temperature:0, messages:[{role:"system",content:$s},{role:"user",content:$u}]}' \
		| curl -fsS -m 120 "$OPENAI_BASE_URL/chat/completions" \
			-H "Authorization: Bearer $OPENAI_API_KEY" -H "content-type: application/json" -d @- \
		| jq -r '.choices[0].message.content' \
		| awk 'BEGIN{f=0} /^```/{f=!f; next} f{print} END{}' \
		| { out=$(cat); [ -n "$out" ] && printf '%s\n' "$out" || printf ''; }
		;;
	*) die "unknown FIXLOOP_PATCH_PROVIDER: $provider" ;;
	esac
}

memory=""; result=needs-human; kept=""
i=1
while [ "$i" -le "$N" ]; do
	echo "== fix-loop attempt $i/$N =="
	cls=$("$REPO/bin/classify-error" "$log")
	class=$(printf '%s' "$cls" | jq -r .class)
	cfile=$(printf '%s' "$cls" | jq -r .file)
	echo "   class=$class file=$cfile"

	# Build the user prompt: classification + failing log tail + offending hunk +
	# memory of prior failed attempts.
	{
		echo "## Build failure (class: $class)"
		echo "$cls" | jq .
		echo; echo "## Compiler output (tail)"; tail -40 "$log"
		if [ -n "$cfile" ] && [ -f "$tree/$cfile" ]; then
			echo; echo "## Offending source: $cfile"; sed -n '1,80p' "$tree/$cfile"
		fi
		[ -n "$memory" ] && { echo; echo "## Prior failed attempts (do NOT repeat)"; printf '%s\n' "$memory"; }
		echo; echo "Emit ONE minimal, guarded unified diff (git apply -p1) that fixes this on musl without changing glibc behavior."
	} > "$work/prompt.txt"

	patch="$work/attempt-$i.patch"
	gen_patch < "$work/prompt.txt" > "$patch" || true
	if [ ! -s "$patch" ]; then echo "   provider produced no patch"; memory="$memory
attempt $i: provider returned empty"; i=$((i+1)); continue; fi
	echo "   candidate patch: $(wc -l < "$patch") lines"

	# Verify in a container: apply the candidate, rebuild. Keep the patch applied
	# on success; revert it on failure so attempts don't accumulate in the tree.
	newlog="$work/verify-$i.log"
	if docker run --rm --user 0 \
		-e VSETUP="$vsetup" -e VCMD="$vcmd" -e TREE="/repo/$tree" -e P="/repo/$patch" \
		-v "$REPO":/repo "$vimage" sh -euc '
			apk add --no-cache git $VSETUP >/dev/null 2>&1   # git: always needed to apply
			cd "$TREE"
			git apply --recount -p1 "$P" 2>&1 || { echo "PATCH_DID_NOT_APPLY"; exit 3; }
			rc=0; sh -c "$VCMD" || rc=$?
			# ALWAYS revert: the tree is a scratch verify surface, never mutated
			# across attempts/runs. The saved patch file is the source of truth;
			# the real gated build (build-package) re-applies it via source=.
			git apply -R --recount -p1 "$P" >/dev/null 2>&1 || true
			exit $rc
		' > "$newlog" 2>&1; then
		echo "   VERIFY PASSED"
		result=fixed; kept="$patch"; break
	fi
	echo "   verify failed ($(grep -c -iE "error:|PATCH_DID_NOT_APPLY" "$newlog" || true) errors)"
	memory="$memory
attempt $i ($class): patch did not fix it — $(grep -m1 -iE 'error:|PATCH_DID_NOT_APPLY' "$newlog" | cut -c1-160)"
	log="$newlog"          # feed the new error into the next attempt
	i=$((i+1))
done

if [ "$result" = fixed ]; then
	echo "fix-loop: FIXED on attempt $((i))"
	if [ "$apply_pkg" = 1 ]; then
		# next free NNN, save the candidate into the package, wire into source=
		nnn=$(printf '%03d' "$(( $(ls "$pdir"/[0-9][0-9][0-9]-*.patch 2>/dev/null | sed 's|.*/||; s/-.*//' | sort -n | tail -1 | sed 's/^0*//') + 1 ))")
		slug=$(printf '%s' "$class" | tr -c 'a-z0-9' '-')
		dest="$pdir/$nnn-fixloop-$slug.patch"
		{ echo "# Fix-Loop: provider=$provider class=$class model=${FIXLOOP_MODEL:-n/a}"; cat "$kept"; } > "$dest"
		echo "fix-loop: wrote candidate patch $dest (HELD FOR HUMAN REVIEW — never auto-merged)"
	fi
	exit 0
fi

echo "fix-loop: NEEDS-HUMAN — $N attempts did not fix it"
echo "$memory"
# CI wrapper (fix.yml) turns this into a labeled PR comment + issue.
exit 1
